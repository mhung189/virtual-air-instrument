def note_name_to_pitch_class(note_str):
    """Tách tên nốt (ví dụ 'C#4' -> chỉ số 1) để xét hợp âm."""
    pitch_part = note_str[:-1]
    if pitch_part in NOTE_NAMES:
        return NOTE_NAMES.index(pitch_part)
    return None


def detect_chord_name(active_notes):
    """Nhận diện tên nốt đơn hoặc hợp âm từ tập hợp các phím đang vang lên."""
    if not active_notes:
        return "---"

    sorted_notes = sorted(
        active_notes,
        key=lambda n: (int(n[-1]), note_name_to_pitch_class(n) or 0),
    )
    if len(sorted_notes) == 1:
        return f"Not don: {sorted_notes[0]}"

    pitch_classes = []
    for n in sorted_notes:
        pc = note_name_to_pitch_class(n)
        if pc is not None and pc not in pitch_classes:
            pitch_classes.append(pc)

    if len(pitch_classes) >= 2:
        for root_pc in pitch_classes:
            intervals = tuple(
                sorted((pc - root_pc) % 12 for pc in pitch_classes)
            )
            if intervals in CHORD_TEMPLATES:
                root_name = NOTE_NAMES[root_pc]
                return f"Hop am: {root_name} {CHORD_TEMPLATES[intervals]}"

    return "Not: " + " + ".join(sorted_notes[:4])
